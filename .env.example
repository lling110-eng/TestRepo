# ── Microsoft Azure / Outlook ─────────────────────────────────────────────────
# Azure AD app registration credentials
# Grant: Mail.Read (or Mail.ReadWrite) application permission
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# The mailbox to monitor (the user whose Sent Items will be synced)
OUTLOOK_USER_EMAIL=yourname@yourcompany.com

# ── NetSuite ──────────────────────────────────────────────────────────────────
# NetSuite account ID (e.g. 1234567 or 1234567_SB1 for sandbox)
NETSUITE_ACCOUNT_ID=your-netsuite-account-id

# Token-Based Authentication (TBA) credentials
# Create an integration record in NetSuite → Setup > Integration > Manage Integrations
# Then generate a token via Setup > Users/Roles > Access Tokens
NETSUITE_CONSUMER_KEY=your-consumer-key
NETSUITE_CONSUMER_SECRET=your-consumer-secret
NETSUITE_TOKEN_KEY=your-token-key
NETSUITE_TOKEN_SECRET=your-token-secret

# ── Sync settings ─────────────────────────────────────────────────────────────
# How often to poll for new emails, in minutes (default 5)
POLL_INTERVAL_MINUTES=5

# Path to store last-sync timestamp between runs (default: .sync_state.json)
SYNC_STATE_FILE=.sync_state.json
